# Copy this file to .env (same directory) and fill in your real keys.
# .env is gitignored - never commit your real keys.
# All variables use the CODEREVIVE_ prefix (see backend/app/config.py).

# Target repository to migrate (change ONLY this line to switch repos, or pass --repo-url on CLI)
CODEREVIVE_REPO_URL=https://github.com/kazuki43zoo/mybatis-spring-boot-jpetstore.git
CODEREVIVE_MIGRATION_BRANCH_NAME=migration/spring-boot-3
CODEREVIVE_DEFAULT_RETRY_BUDGET=5

# Target Spring Boot & Java versions
CODEREVIVE_TARGET_SPRING_BOOT_VERSION=3.2.5
CODEREVIVE_TARGET_JAVA_VERSION=17
CODEREVIVE_USE_OPENREWRITE=true
CODEREVIVE_OPENREWRITE_MODE=hybrid
CODEREVIVE_OPENREWRITE_TIMEOUT_SECONDS=600
CODEREVIVE_SANDBOX_TIMEOUT_SECONDS=600
CODEREVIVE_SANDBOX_MEMORY_LIMIT=4g
CODEREVIVE_SANDBOX_DYNAMIC_SERVICES=true

# Which LLM provider to use: "gemini", "nvidia", or "openrouter"
CODEREVIVE_LLM_PROVIDER=openrouter

# Google Gemini - get a key at https://aistudio.google.com/app/apikey
CODEREVIVE_GEMINI_API_KEY=your-gemini-api-key-here
CODEREVIVE_GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM - get a key at https://build.nvidia.com/
CODEREVIVE_NVIDIA_API_KEY=your-nvidia-api-key-here
CODEREVIVE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CODEREVIVE_NVIDIA_MODEL=mistralai/mistral-large-2-instruct

# OpenRouter - get a key at https://openrouter.ai/keys (or set OPENROUTER_API_KEY)
CODEREVIVE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
CODEREVIVE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CODEREVIVE_OPENROUTER_MODEL=openai/gpt-oss-120b
CODEREVIVE_OPENROUTER_REASONING_ENABLED=true
# Optional reasoning effort ("low" | "medium" | "high") and leaderboard headers:
# CODEREVIVE_OPENROUTER_REASONING_EFFORT=medium
# CODEREVIVE_OPENROUTER_SITE_URL=https://your-site.example
CODEREVIVE_OPENROUTER_APP_NAME=CodeRevive

# HTTP API server & Angular CORS configuration
CODEREVIVE_API_HOST=127.0.0.1
CODEREVIVE_API_PORT=8000
CODEREVIVE_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Optional path to compiled Angular dist/browser directory for single-origin production serving:
# CODEREVIVE_FRONTEND_DIST_DIR=