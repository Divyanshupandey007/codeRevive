# Copy this file to .env (same directory) and fill in your real keys.
# .env is gitignored - never commit your real keys.
# All variables use the CODEREVIVE_ prefix (see backend/app/config.py).

# Which LLM provider to use: "gemini" or "nvidia"
CODEREVIVE_LLM_PROVIDER=gemini

# Google Gemini - get a key at https://aistudio.google.com/app/apikey
CODEREVIVE_GEMINI_API_KEY=your-gemini-api-key-here
CODEREVIVE_GEMINI_MODEL=gemini-3.8-flash

# NVIDIA NIM - get a key at https://build.nvidia.com/
CODEREVIVE_NVIDIA_API_KEY=your-nvidia-api-key-here
CODEREVIVE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CODEREVIVE_NVIDIA_MODEL=mistral-large-4-1t-a52b
