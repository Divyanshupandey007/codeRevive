FROM maven:3.9-eclipse-temurin-17

# Install Google Chrome, unzip, and dependencies for browser tests (Selenide, ChromeDriver)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    unzip \
    ca-certificates \
    && wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get install -y --no-install-recommends ./google-chrome-stable_current_amd64.deb \
    && rm -f google-chrome-stable_current_amd64.deb \
    && wget -q https://storage.googleapis.com/chrome-for-testing-public/157.0.8103.78/linux64/chromedriver-linux64.zip \
    && unzip -q chromedriver-linux64.zip \
    && mv chromedriver-linux64/chromedriver /usr/local/bin/chromedriver-real \
    && printf '#!/bin/bash\nexec /usr/local/bin/chromedriver-real --allowed-origins=* "$@"\n' > /usr/local/bin/chromedriver \
    && chmod +x /usr/local/bin/chromedriver /usr/local/bin/chromedriver-real \
    && ln -s /usr/local/bin/chromedriver /usr/bin/chromedriver \
    && rm -rf chromedriver-linux64.zip chromedriver-linux64 \
    && rm -rf /var/lib/apt/lists/*

# Wrap the actual chrome binary so ANY invocation (chromedriver, wrapper scripts, direct exec) always has --no-sandbox
RUN mv /opt/google/chrome/chrome /opt/google/chrome/chrome-real \
    && printf '#!/bin/bash\nexec /opt/google/chrome/chrome-real --no-sandbox --disable-dev-shm-usage --disable-gpu --remote-allow-origins=* "$@"\n' > /opt/google/chrome/chrome \
    && chmod +x /opt/google/chrome/chrome

ENV CHROME_BIN=/usr/bin/google-chrome
ENV webdriver.chrome.driver=/usr/local/bin/chromedriver
